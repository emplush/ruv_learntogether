<?xml version="1.0" encoding="utf-8"?>
<!--
  LearnTogether - IIS-Konfiguration (ASP.NET 4.x, kein Node.js erforderlich).
  Voraussetzungen: IIS mit ASP.NET 4.x (.NET Framework 4.6 oder neuer). Anwendungspool-Identitaet braucht Schreibrechte auf AppData\Data.
-->
<configuration>
  <system.web>
    <compilation debug="false" />
    <httpRuntime maxRequestLength="8192" enableVersionHeader="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <!-- Datenordner (Veranstaltungen, Anmeldungen, Einstellungen, Bilder) ist ueber HTTP nie erreichbar -->
        <hiddenSegments>
          <add segment="Data" />
          <add segment="Private" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
    <!-- Komprimierung: index.html und JSON-Antworten werden deutlich kleiner uebertragen (wirkt, sofern die IIS-Module installiert sind) -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <!-- index.html soll nach einem Update sofort neu geladen werden, nicht aus dem Browser-Cache -->
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".ics" />
      <mimeMap fileExtension=".ics" mimeType="text/calendar" />
    </staticContent>
  </system.webServer>
  <!-- Schriften, Logos und Handbuch-Bilder aendern sich selten: 7 Tage im Browser-Cache -->
  <location path="AppData/fonts">
    <system.webServer><staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" /></staticContent></system.webServer>
  </location>
  <location path="AppData/assets">
    <system.webServer><staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" /></staticContent></system.webServer>
  </location>
  <location path="AppData/handbuch">
    <system.webServer><staticContent><clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" /></staticContent></system.webServer>
  </location>
</configuration>
