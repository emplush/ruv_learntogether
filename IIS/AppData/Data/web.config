<?xml version="1.0" encoding="utf-8"?>
<!-- Zweite Absicherung: Kein direkter Zugriff auf Datendateien. -->
<configuration>
  <system.web>
    <authorization>
      <deny users="*" />
    </authorization>
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
